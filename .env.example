# Copy this file to .env and fill in your own keys. Never commit .env.

# paper = simulated money (default). live = real money.
TRADING_MODE=paper

# Alpaca - https://app.alpaca.markets. TRADING_MODE picks which pair is used.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=

# Interactive Brokers - Trader Workstation or IB Gateway must be running with
# "Enable ActiveX and Socket Clients" ticked (Settings > API).
# Leave IBKR_PORT blank to use the TWS default (7497 paper, 7496 live).
# IB Gateway uses 4002 paper, 4001 live.
IBKR_ENABLED=false
IBKR_HOST=127.0.0.1
IBKR_PORT=
IBKR_CLIENT_ID=17

# Claude research panel - https://console.anthropic.com
ANTHROPIC_API_KEY=

# Gemini research panel - https://aistudio.google.com (used when no Anthropic key is set)
GEMINI_API_KEY=

# Default watchlist for the MON screen
WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,JPM

# Finnhub - https://finnhub.io (earnings calendar, earnings surprises, insider trades)
FINNHUB_API_KEY=

# Financial Modeling Prep - https://financialmodelingprep.com (valuation, ratings, scores)
FMP_API_KEY=

# FRED economic data - https://fred.stlouisfed.org/docs/api/api_key.html (free)
FRED_API_KEY=

# SEC EDGAR asks every app to identify itself with a contact email (any address of yours)
SEC_CONTACT_EMAIL=
